{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test build",
    "db:start": "pnpm --filter @repo/db db:start",
    "db:stop": "pnpm --filter @repo/db db:stop",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:lint": "pnpm --filter @repo/db db:lint",
    "test:db": "pnpm --filter @repo/db test:db",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:types": "pnpm --filter @repo/db db:types"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
