# Variables de apps/web. En local se generan con: pnpm --filter @repo/web env:local
# Solo URL y clave publicable (llegan al navegador si se usan en el cliente).
# Nunca la clave secreta ni la service role: la app no las usa (AGENTS.md).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Solo servidor (nunca NEXT_PUBLIC_): clave del freno del login. Su hash se
# registra en la base de datos con public.register_server_key (plataforma).
# En local la generan pnpm db:seed y env:local. No da acceso a datos.
LOGIN_THROTTLE_KEY=
# Solo servidor: clave de los seudónimos de los logs (HMAC de emails e IPs,
# ADR 0032). Al menos 32 caracteres aleatorios; sin ella, los logs no llevan
# seudónimos. En local la genera env:local y la conserva entre ejecuciones.
LOG_PSEUDONYM_KEY=
# Opcional: nivel de los logs (trace, debug, info, warn, error). Por defecto, info.
LOG_LEVEL=
# Opcional: errores a Sentry (ADR 0032). Sin DSN, Sentry no se activa (local, CI
# y e2e). El DSN es público por diseño: llega al navegador, que manda los
# errores por el tunnel propio (/monitoring). En staging, en Vercel.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Opcional, solo servidor: Nango, la plataforma de conectores (O-02, ADR 0053).
# La clave de API del entorno de Nango (Environment Settings → API Keys). Sin
# ella, Ajustes → Integraciones dice que no están disponibles.
NANGO_API_KEY=
# Opcional: la URL base de Nango. Por defecto, Nango Cloud (https://api.nango.dev);
# la instancia autoalojada en la UE, antes del primer dato real. https, o http
# solo en loopback (el stub de los e2e).
NANGO_HOST=
